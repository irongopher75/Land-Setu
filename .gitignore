This is my gitignore file
# Runtime and dependency artifacts
frontend/node_modules/
frontend/dist/
backend/__pycache__/
backend/app/**/__pycache__/
*.py[cod]
*.db

# Secrets and local configuration
.env
.env.*
!.env.example
!frontend/.env.production

# One-off local artifacts, not tracked
audit.md
Land-Setu-code.zip
# Firebase CLI local artifacts
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Local agent/skill config (not pushed to repo)
.claude/
.agents/

# Local agent and skill config, editor files
AGENTS.md
CLAUDE.md
SKILLS.md
.DS_Store
**/.DS_Store
venv/
.venv/

# Local tool output
secrets-report.json
skills-lock.json
tests/firestore-rules/node_modules/

# Exports of live Firestore data (may contain fabricated owner names; kept locally as evidence, never committed)
docs/firestore-export-*.json
