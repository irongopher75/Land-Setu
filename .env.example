# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-64-character-secret
CORS_ORIGINS=http://localhost:5173
# Enable only for isolated local demos. It grants a redacted citizen session only.
DEMO_LOGIN_ENABLED=false
# False only when developing over plain HTTP on localhost.
COOKIE_SECURE=true
# Keep false to hide seeded mock parcel rectangles from the GIS map.
VITE_SHOW_SEEDED_PARCELS=false
